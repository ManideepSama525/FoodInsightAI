# FoodInsightAI model-training environment
# Copy to .env only if needed.
# Public SmolLM2 download does NOT require HF_TOKEN.

HF_TOKEN=
MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
MODEL_REVISION=
MODEL_DIR=models/SmolLM2-360M-Instruct

TRAIN_MODE=lora
MAX_SEQ_LENGTH=512
NUM_EPOCHS=2
TRAIN_BATCH_SIZE=1
EVAL_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=0.0002
WARMUP_RATIO=0.03
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
SEED=20261001

# Optional output locations
TRAIN_OUTPUT_DIR=artifacts/foodinsight_lora
EVAL_OUTPUT=research/evaluation/model_benchmark_results.json
